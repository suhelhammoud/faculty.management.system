{
  "name": "faculty.management.system",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "pnpm -r --parallel --filter './apps/*' --filter '!./apps/api' run dev",
    "dev:api": "pnpm --filter ./apps/api start:dev",
    "dev:shell": "pnpm --filter ./apps/shell dev",
    "dev:attendance": "pnpm --filter ./apps/attendance dev",
    "dev:maintenance": "pnpm --filter ./apps/maintenance dev",
    "dev:supervision": "pnpm --filter ./apps/supervision dev",
    "dev:meetings": "pnpm --filter ./apps/meetings dev",
    "dev:hr": "pnpm --filter ./apps/hr dev",
    "dev:exams": "pnpm --filter ./apps/exams dev",
    "dev:correspondence": "pnpm --filter ./apps/correspondence dev",
    "dev:inventory": "pnpm --filter ./apps/inventory dev",
    "dev:student-affairs": "pnpm --filter ./apps/student-affairs dev",
    "dev:facilities": "pnpm --filter ./apps/facilities dev",
    "build:frontends": "pnpm --filter './apps/*' --filter '!./apps/api' -r run build",
    "build:shell": "pnpm --filter ./apps/shell build",
    "build:attendance": "pnpm --filter ./apps/attendance build",
    "build:maintenance": "pnpm --filter ./apps/maintenance build",
    "build:supervision": "pnpm --filter ./apps/supervision build",
    "build:meetings": "pnpm --filter ./apps/meetings build",
    "build:hr": "pnpm --filter ./apps/hr build",
    "build:exams": "pnpm --filter ./apps/exams build",
    "build:correspondence": "pnpm --filter ./apps/correspondence build",
    "build:inventory": "pnpm --filter ./apps/inventory build",
    "build:student-affairs": "pnpm --filter ./apps/student-affairs build",
    "build:facilities": "pnpm --filter ./apps/facilities build",
    "dev:admin": "pnpm --filter ./apps/admin dev",
    "build:admin": "pnpm --filter ./apps/admin build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.18.0",
  "type": "module"
}
