{
  "name": "faculty.management.system",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "prepare": "husky",
    "format": "prettier --write \"apps/*/src/**/*.{ts,tsx,js,jsx,json,css,html}\" \"packages/*/src/**/*.{ts,tsx,js,jsx,json,css,html}\"",
    "format:check": "prettier --check \"apps/*/src/**/*.{ts,tsx,js,jsx,json,css,html}\" \"packages/*/src/**/*.{ts,tsx,js,jsx,json,css,html}\"",
    "dev": "pnpm run dev:web",
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter ./apps/api start:dev",
    "build:web": "pnpm --filter web build",
    "build:frontends": "pnpm run build:web",
    "test:pilot": "pnpm --filter api build && node packages/db/test/pilot.mjs",
    "test:frontend:smoke": "playwright test --config playwright.frontend.config.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "prettier": "^3.4.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,css,html,md,yml,yaml}": "prettier --write"
  },
  "packageManager": "pnpm@12.18.0",
  "type": "module"
}
